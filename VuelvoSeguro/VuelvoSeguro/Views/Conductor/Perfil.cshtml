@model Usuario
@{
    ViewData["Title"] = "Perfil";
    ViewData["Ancho"] = "medio";
    ViewData["Nav"] = "perfil";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div class="avatar">@($"{Model.Nombre.FirstOrDefault()}{Model.Apellido.FirstOrDefault()}".ToUpper())</div>
    <div>
        <div class="fw-bold fs-5">@Model.NombreCompleto</div>
        <div class="small text-body-secondary">@Model.Email</div>
        <span class="badge text-bg-success mt-1">Conductor aprobado</span>
    </div>
</div>
<div class="list-group mb-3">
    <div class="list-group-item"><div class="dato">Teléfono</div>@Model.PhoneNumber</div>
    <div class="list-group-item"><div class="dato">Licencia</div>@Model.NumeroLicencia</div>
    <div class="list-group-item"><div class="dato">Vencimiento</div>@Model.VencimientoLicencia?.ToString("dd/MM/yyyy")</div>
    <div class="list-group-item"><div class="dato">Antecedentes penales</div>Certificado presentado y verificado</div>
</div>
<form asp-controller="Cuenta" asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-danger w-100">Cerrar sesión</button>
</form>
