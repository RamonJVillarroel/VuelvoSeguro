@model Usuario
@{
    ViewData["Title"] = "Cuenta en revisión";
    ViewData["Ancho"] = "medio";
    var documentosEnviados = Model.RutaAntecedentes != null;
}

@if (Model.EstadoUsuarioId == EstadoUsuario.Rechazado)
{
    <div class="text-center my-4">
        <div class="avatar mx-auto mb-3" style="background:#dc3545;width:80px;height:80px;font-size:2rem">✕</div>
        <h4>Tu cuenta fue rechazada</h4>
        <p class="text-body-secondary">Un administrador revisó tus datos y no aprobó tu cuenta.</p>
    </div>
}
else
{
    <div class="text-center my-4">
        <div class="avatar mx-auto mb-3" style="background:#e8a317;width:80px;height:80px;font-size:2rem">⌛</div>
        <h4>Tu cuenta está en revisión</h4>
        <p class="text-body-secondary">Un administrador tiene que revisar tu licencia, tu DNI y tu certificado de antecedentes penales. Cuando te apruebe vas a poder aceptar viajes.</p>
    </div>
    <ul class="pasos mb-4">
        <li class="hecho"><span class="punto">✓</span>Datos personales cargados</li>
        @if (documentosEnviados)
        {
            <li class="hecho"><span class="punto">✓</span>Licencia, DNI y antecedentes penales enviados</li>
            <li class="actual"><span class="punto">3</span>Aprobación del administrador</li>
        }
        else
        {
            <li class="actual"><span class="punto">2</span>Licencia, DNI y antecedentes penales</li>
            <li><span class="punto">3</span>Aprobación del administrador</li>
        }
    </ul>
}
<form asp-controller="Cuenta" asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-danger w-100">Cerrar sesión</button>
</form>
