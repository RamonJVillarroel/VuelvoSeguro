<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VuelvoSeguro</title>
    <script>
        // Tema claro u oscuro según el dispositivo, como en el prototipo.
        document.documentElement.setAttribute('data-bs-theme',
            window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VuelvoSeguro.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark barra-vs mb-4">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="Home" asp-action="Index">Vuelvo<span>Seguro</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole(Rol.Pasajero))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Pasajero" asp-action="Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pasajero" asp-action="Vehiculo">Mi vehículo</a></li>
                        }
                        else if (User.IsInRole(Rol.Conductor))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Conductor" asp-action="Index">Inicio</a></li>
                        }
                        else if (User.IsInRole(Rol.Administrador))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Panel</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="navbar-text me-3">@User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm mt-1">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Ingresar</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Registrarse</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success">@mensaje</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-body-secondary">
        <div class="container">
            &copy; 2026 - VuelvoSeguro
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
