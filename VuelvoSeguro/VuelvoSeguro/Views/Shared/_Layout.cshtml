@{
    var nav = ViewData["Nav"] as string;
    var etiqueta = User.IsInRole(Rol.Pasajero) ? "Pasajero" : User.IsInRole(Rol.Conductor) ? "Conductor" : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VuelvoSeguro</title>
    <partial name="_Tema" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="escenario">
        <div class="celular">
            <div class="barra-app">
                <a class="marca" asp-controller="Home" asp-action="Index">Vuelvo<span>Seguro</span></a>
                @if (etiqueta != null)
                {
                    <span class="badge rounded-pill bg-light text-dark">@etiqueta</span>
                }
            </div>
            <main class="contenido" role="main">
                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success">@mensaje</div>
                }
                @RenderBody()
            </main>
            @if (nav != null && User.IsInRole(Rol.Pasajero))
            {
                <nav class="nav-inferior" aria-label="Navegación">
                    <a asp-controller="Pasajero" asp-action="Index" class="@(nav == "inicio" ? "activo" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /></svg>Inicio
                    </a>
                    <a asp-controller="Pasajero" asp-action="Historial" class="@(nav == "historial" ? "activo" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>Historial
                    </a>
                    <a asp-controller="Pasajero" asp-action="Perfil" class="@(nav == "perfil" ? "activo" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-7 8-7s8 3 8 7" /></svg>Perfil
                    </a>
                </nav>
            }
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
