@model List<Viaje>
@{
    // RF10: lista de viajes terminados. Sirve para el pasajero y para el conductor.
    var esConductor = User.IsInRole(Rol.Conductor);
}
@if (Model.Count == 0)
{
    <div class="list-group">
        <div class="list-group-item py-3 text-body-secondary">Todavía no hiciste ningún viaje.</div>
    </div>
}
else
{
    <p class="text-body-secondary small mb-2">@Model.Count @(Model.Count == 1 ? "viaje" : "viajes")</p>
    <div class="list-group historial">
        @foreach (var v in Model)
        {
            var cancelado = v.EstadoViajeId == EstadoViaje.Cancelado;
            var otro = esConductor ? v.Pasajero : v.Conductor;
            var fecha = cancelado ? v.FechaCancelacion ?? v.FechaPublicacion : v.FechaViajeFin ?? v.FechaPublicacion;
            <div class="list-group-item py-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <span class="fw-semibold">@fecha.ToString("dd/MM/yyyy · HH:mm")</span>
                    <span class="badge text-bg-@EstadoViaje.Color(v.EstadoViajeId)">@v.EstadoViaje?.NombreEstado</span>
                </div>
                <div class="small"><span class="pin origen me-1"></span>@v.DireccionOrigen</div>
                <div class="small"><span class="pin destino me-1"></span>@v.DireccionDestino</div>
                <div class="small text-body-secondary mt-1">
                    @(esConductor ? "Pasajero" : "Conductor"): @(otro?.NombreCompleto ?? "sin asignar")
                    @if (!cancelado && v.FechaViajeInicio is DateTime inicio && v.FechaViajeFin is DateTime fin)
                    {
                        <span>· @Math.Max(1, (int)Math.Round((fin - inicio).TotalMinutes)) min</span>
                    }
                </div>
                @if (cancelado)
                {
                    <div class="small mt-1">
                        <span class="text-danger">Cancelado por @(v.CanceladoPorId == v.PasajeroId ? (esConductor ? "el pasajero" : "vos") : (esConductor ? "vos" : "el conductor")):</span>
                        @v.MotivoCancelacion
                    </div>
                }
            </div>
        }
    </div>
}
