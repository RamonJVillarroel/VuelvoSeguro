@model Viaje
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 align-items-start py-1">
            <span class="pin origen mt-1"></span>
            <div><div class="dato">Origen</div><div>@Model.DireccionOrigen</div></div>
        </div>
        <div class="d-flex gap-2 align-items-start py-1">
            <span class="pin destino mt-1"></span>
            <div><div class="dato">Destino</div><div>@Model.DireccionDestino</div></div>
        </div>
    </div>
</div>
