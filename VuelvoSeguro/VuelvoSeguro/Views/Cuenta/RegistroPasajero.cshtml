@model RegistroPasajeroViewModel
@{
    ViewData["Title"] = "Registro de pasajero";
}

<div class="formulario">
    <h2 class="mb-3">Registro de pasajero</h2>
    <form asp-action="RegistroPasajero" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_DatosPersonales" model="Model" />

        <h5 class="mt-3">Dirección de tu casa</h5>
        <p class="small text-body-secondary mb-2">Es el destino de tus viajes.</p>
        <div class="mb-3">
            <input asp-for="Direccion" class="form-control" autocomplete="street-address" aria-label="Dirección de tu casa" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <h5>Tu vehículo</h5>
        <p class="small text-body-secondary mb-2">El conductor maneja tu auto para llevarte.</p>
        <partial name="_CamposVehiculo" for="Vehiculo" />

        <button type="submit" class="btn btn-vs btn-grande w-100">Crear cuenta</button>
    </form>
    <p class="text-center mt-3"><a asp-action="Registro">Volver</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
