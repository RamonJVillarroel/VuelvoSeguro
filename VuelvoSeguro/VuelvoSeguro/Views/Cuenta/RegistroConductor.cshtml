@model RegistroConductorViewModel
@{
    ViewData["Title"] = "Registro de conductor";
}

<div class="formulario">
    <h2 class="mb-3">Registro de conductor</h2>
    <form asp-action="RegistroConductor" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_DatosPersonales" model="Model" />

        <div class="alert alert-info small py-2">Un administrador revisa tus datos antes de que puedas aceptar viajes.</div>
        <button type="submit" class="btn btn-navy btn-grande w-100">Crear cuenta</button>
    </form>
    <p class="text-center mt-3"><a asp-action="Registro">Volver</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
