@model List<Usuario>
@{
    ViewData["Title"] = "Conductores pendientes";
    Layout = "_LayoutAdmin";
    ViewData["Seccion"] = "conductores";
    ViewData["Pendientes"] = Model.Count;
}

@if (Model.Count == 0)
{
    <h4>Conductores pendientes</h4>
    <div class="alert alert-success">No hay conductores esperando aprobación.</div>
}
else
{
    <h4 class="mb-3">Conductores pendientes de aprobación</h4>
    <div class="list-group">
        @foreach (var c in Model)
        {
            <div class="list-group-item d-flex align-items-center gap-3">
                <div class="avatar sm">@($"{c.Nombre.FirstOrDefault()}{c.Apellido.FirstOrDefault()}".ToUpper())</div>
                <div class="text-break">
                    <div class="fw-semibold">@c.NombreCompleto</div>
                    <div class="small text-body-secondary">@c.Email · DNI @c.Dni</div>
                </div>
            </div>
        }
    </div>
}
