@model List<Viaje>
@{
    ViewData["Title"] = "Viajes";
    Layout = "_LayoutAdmin";
    ViewData["Seccion"] = "viajes";
}

<h4 class="mb-3">Viajes</h4>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no se publicó ningún viaje.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle small">
            <thead><tr><th>N.º</th><th>Fecha</th><th>Pasajero</th><th>Conductor</th><th>Origen</th><th>Destino</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td class="text-nowrap">@v.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Pasajero?.NombreCompleto</td>
                        <td>@(v.Conductor?.NombreCompleto ?? "-")</td>
                        <td>@v.DireccionOrigen</td>
                        <td>@v.DireccionDestino</td>
                        <td><span class="badge text-bg-@EstadoViaje.Color(v.EstadoViajeId)">@v.EstadoViaje?.NombreEstado</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
