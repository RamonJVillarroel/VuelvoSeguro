@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-5 fw-bold" style="color: var(--vs-green)">Volvé seguro</h1>
    <p class="lead text-body-secondary">Un conductor te lleva a casa en tu propio auto.</p>
    <div class="d-grid gap-3 formulario mt-4">
        <a class="btn btn-vs btn-grande" asp-controller="Cuenta" asp-action="Login">Ingresar</a>
        <a class="btn btn-outline-secondary btn-grande" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
    </div>
</div>
