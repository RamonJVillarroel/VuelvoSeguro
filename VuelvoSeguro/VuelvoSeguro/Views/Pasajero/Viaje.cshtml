@model Viaje
@{
    ViewData["Title"] = "Mi viaje";
    ViewData["Ancho"] = "medio";
    ViewData["Nav"] = "inicio";
    var estado = Model.EstadoViajeId;
    var activo = ViajeService.EstadosActivos.Contains(estado);
    // Paso actual: 0 = conductor en camino, 1 = viaje en curso, 2 = llegada.
    var paso = estado == EstadoViaje.Aceptado ? 0 : estado == EstadoViaje.EnCurso ? 1 : 2;
    string Clase(int n) => paso > n ? "hecho" : paso == n ? "actual" : "";
    string Punto(int n) => paso > n ? "✓" : (n + 1).ToString();
}
@section Head {
    @if (activo)
    {
        @* Sin notificaciones en tiempo real: la pantalla se actualiza sola cada 15 segundos. *@
        <meta http-equiv="refresh" content="15" />
    }
}

@if (estado == EstadoViaje.Publicado)
{
    <div class="text-center mt-3 mb-4">
        <div class="radar mb-4"><div></div></div>
        <h4>Buscando conductor</h4>
        <p class="text-body-secondary">Tu viaje está publicado. Cuando un conductor lo acepte lo vas a ver acá.</p>
    </div>
    <partial name="_Recorrido" model="Model" />
}
else if (estado == EstadoViaje.Finalizado)
{
    <div class="text-center my-4">
        <div class="avatar mx-auto mb-3" style="background:var(--vs-green);width:80px;height:80px;font-size:2rem">✓</div>
        <h3>¡Llegaste a casa!</h3>
        <p class="text-body-secondary">Tu viaje terminó sin problemas.</p>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between"><span class="dato">Conductor</span><span>@Model.Conductor?.NombreCompleto</span></div>
            <hr class="my-2">
            <div class="d-flex justify-content-between gap-3"><span class="dato">Desde</span><span class="text-end small">@Model.DireccionOrigen</span></div>
            <div class="d-flex justify-content-between gap-3 mt-1"><span class="dato">Hasta</span><span class="text-end small">@Model.DireccionDestino</span></div>
            <div class="d-flex justify-content-between gap-3 mt-1"><span class="dato">Llegada</span><span>@Model.FechaViajeFin?.ToString("dd/MM/yyyy HH:mm")</span></div>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-vs btn-grande w-100 mb-2">Volver al inicio</a>
}
else if (estado == EstadoViaje.Cancelado)
{
    <h4>Viaje cancelado</h4>
    <partial name="_Recorrido" model="Model" />
    <a asp-action="Index" class="btn btn-vs btn-grande w-100">Volver al inicio</a>
}
else
{
    <div class="mb-2"><span class="badge text-bg-@EstadoViaje.Color(estado)">@(estado == EstadoViaje.Aceptado ? "Conductor en camino" : "Viaje en curso")</span></div>
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="avatar">@($"{Model.Conductor!.Nombre.FirstOrDefault()}{Model.Conductor.Apellido.FirstOrDefault()}".ToUpper())</div>
            <div class="flex-grow-1">
                <div class="dato">Tu conductor</div>
                <div class="fw-bold fs-5">@Model.Conductor.NombreCompleto</div>
                <div class="small text-body-secondary">Licencia verificada · Tel. @Model.Conductor.PhoneNumber</div>
            </div>
        </div>
    </div>
    <ul class="pasos mb-3">
        <li class="@Clase(0)"><span class="punto">@Punto(0)</span>Conductor en camino</li>
        <li class="@Clase(1)"><span class="punto">@Punto(1)</span>Viaje en curso hacia tu casa</li>
        <li class="@Clase(2)"><span class="punto">@Punto(2)</span>Llegada a tu casa</li>
    </ul>
    <partial name="_Recorrido" model="Model" />
    <partial name="_AutoDelViaje" model="Model.Vehiculo" />
}

@if (activo)
{
    <a asp-action="Viaje" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">Actualizar estado</a>
}
